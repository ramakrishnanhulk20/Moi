# Binance Web3 API credentials from https://web3.binance.com/en/dev-portal
OC_API_KEY=
OC_SECRET_KEY=

# Deploys GiftVault and acts as the test sender in scripts. Fund with a little BNB and USDT on BSC.
DEPLOYER_PRIVATE_KEY=

# Submits claims and pays their gas. Fund with a little BNB on BSC. Holds nothing else.
RELAYER_PRIVATE_KEY=

# Verifies GiftVault on BscScan. Free key from https://etherscan.io/myapikey (one key covers BSC).
ETHERSCAN_API_KEY=

# Privy app for the friend's email or Google wallet. Public, not a secret. https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Public address of the relayer wallet above; the deploy script reads it so it never needs the relayer key.
MOI_RELAYER_ADDRESS=

# Ram's own wallet; the vault owner is handed to it after deploy (Ram accepts with one signature).
MOI_OWNER_ADDRESS=

# Set after the vault is deployed on BSC mainnet.
MOI_VAULT_ADDRESS=

# Relayer limits (optional; defaults are 3 gwei and 0.002 BNB a day).
MOI_RELAYER_MAX_GAS_PRICE_WEI=
MOI_RELAYER_DAILY_CAP_WEI=

# Upstash Redis REST (free tier): remembers claimed gifts and judge handouts. Region Singapore or Frankfurt.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# b402 gift wrapping: the fee per gift, and the wallet the fees settle to (Ram's payout wallet, set in the B402 application).
MOI_WRAP_PRICE_USD=0.05
MOI_PAYOUT_ADDRESS=

# The wallet that creates judge gifts; the relayer delivers its gifts without a wrapping fee.
MOI_SPONSOR_ADDRESS=

# The public site origin printed in gift links (https in production).
MOI_PUBLIC_ORIGIN=http://localhost:3000

# Judge gifts: a secret 32-byte seed (0x + 64 hex) the server derives each judge gift's claim key from,
# and the pool printed by `npm run judge-gifts` (giftId:index,...).
MOI_JUDGE_SEED=
MOI_JUDGE_POOL=
# Judge gift creation (npm run judge-gifts): how many, which stock, dollars each.
MOI_JUDGE_COUNT=10
MOI_JUDGE_STOCK=0x02fca66c1d1afb4e2a7884261eb00f63598a7436
MOI_JUDGE_USD_EACH=1

# Where the sender agent reaches Moi's server for b402 wrapping (https in production).
MOI_SERVER_ORIGIN=http://localhost:3000

# Local development only. MOI_ALLOW_MEMORY_STORE=1 runs without Upstash (one process); MOI_DEV_COUNTRY is the
# country a local request claims (production reads the hosting platform's header); PORT for npm run serve.
MOI_ALLOW_MEMORY_STORE=
MOI_DEV_COUNTRY=
MOI_DEV_ALLOW_UNKNOWN_COUNTRY=
PORT=3000
